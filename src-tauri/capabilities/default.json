{
  "identifier": "default",
  "description": "Default desktop capability for Mail Catcher",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "store:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/backend",
          "sidecar": true
        }
      ]
    },
    {
      "identifier": "shell:allow-kill",
      "allow": [
        {
          "name": "binaries/backend",
          "sidecar": true
        }
      ]
    }
  ]
}
