# ─── Database ────────────────────────────────────────────
# Khi chạy docker-compose: tự động được override
# Khi chạy local: sửa thành DB của bạn
DATABASE_URL="postgresql://mail_user:mail_pass@localhost:5432/mail_testing?schema=public"

# ─── IMAP ────────────────────────────────────────────────
IMAP_HOST="mail.example.com"
IMAP_PORT=993
IMAP_USER="inbox@example.com"
IMAP_PASSWORD="your-imap-password-here"
IMAP_TLS=true

# ─── IMAP Worker Mode ────────────────────────────────────
IMAP_MODE="idle"
IMAP_POLL_INTERVAL=5000

# ─── Mail Domain ─────────────────────────────────────────
# Domain to filter incoming emails (only emails to *@MAIL_DOMAIN are processed)
MAIL_DOMAIN="example.com"
# Base address (local-part before +) for thread labels
MAIL_BASE_ADDRESS="inbox"

# ─── App ─────────────────────────────────────────────────
PORT=3000
ATTACHMENT_STORAGE_DIR="./uploads/attachments"
FRONTEND_URL="http://localhost"
