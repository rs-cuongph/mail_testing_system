# ─── Database ────────────────────────────────────────────
# Khi chạy docker-compose: tự động được override
# Khi chạy local: sửa thành DB của bạn
DATABASE_URL="postgresql://mail_user:mail_pass@localhost:5432/mail_testing?schema=public"

# ─── Security ────────────────────────────────────────────
# [Optional] Used for AES-256 encryption of credentials.
# If omitted, it will default to a 32-character development key: "your_secret_key_123_456_789_0123"
# For production, you SHOULD define a secure 32-byte string.
ENCRYPTION_KEY="your_secret_key_123_456_789_0123"

# ─── App ─────────────────────────────────────────────────
# All fields below are optional and have built-in defaults.
# Default: 7654
PORT=7654
# Default: ./uploads/attachments
ATTACHMENT_STORAGE_DIR="./uploads/attachments"
# Default: http://localhost,http://localhost:5173
FRONTEND_URL="http://localhost"
